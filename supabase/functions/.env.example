# =====================================================
# RaahPrahari - SERVER-ONLY environment variables (Edge Functions)
# Copy karo:  cp supabase/functions/.env.example supabase/functions/.env
# Is file me KABHI asli value commit mat karna.
#
# Ye variables sirf server par rehte hain. Frontend me kabhi nahi.
#
# NOTE: SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
# Supabase Edge Functions me AUTOMATICALLY mil jati hain.
# Unhe yahan mat likho (SUPABASE_ se shuru hone wale custom secrets
# set nahi hote).
# =====================================================

# development | demo | pilot  (frontend ke VITE_APP_ENV se match hona chahiye)
APP_ENV=

# AI provider ki key (BE2 ka kaam). Optional: khali ho to AI "unavailable" maana jayega.
AI_API_KEY=